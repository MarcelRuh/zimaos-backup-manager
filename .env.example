# HTTP listen address (container default)
LISTEN_ADDR=:8787

# Path to SQLite database and application data
DATA_DIR=/data

# Base URL of the ZimaOS API reachable from the container.
# On ZimaOS/Docker use host.docker.internal (see docker-compose.yml extra_hosts).
ZIMAOS_API_BASE_URL=http://host.docker.internal

# ZimaOS API auth (required from Docker; localhost bypass does not apply).
# Prefer username/password – the app logs in via POST /v1/users/login and
# refreshes the temporary access_token automatically. Never commit secrets.
# ZIMAOS_API_USERNAME=
# ZIMAOS_API_PASSWORD=
# Optional pre-seeded JWT (raw token, no "Bearer " prefix):
# ZIMAOS_API_TOKEN=

# Default timezone for schedules
TZ=Europe/Berlin

# Public URL of this app (used for cookie Secure flag heuristics in reverse proxies)
# APP_PUBLIC_URL=http://localhost:8787

# Session cookie name
SESSION_COOKIE_NAME=zbm_session

# Development only: allow insecure cookies over HTTP
# COOKIE_SECURE=false
